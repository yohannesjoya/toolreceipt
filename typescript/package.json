{
  "name": "toolreceipt",
  "version": "0.2.0",
  "description": "Catch LLM agents claiming actions they never took. Ledger + claim extraction + receipt, same fixtures as the Python package.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/yohannesjoya/toolreceipt.git", "directory": "typescript" },
  "homepage": "https://github.com/yohannesjoya/toolreceipt",
  "keywords": ["llm", "agents", "tool-calls", "hallucination", "receipt", "openai", "anthropic", "vercel-ai-sdk", "langgraph", "langchain"],
  "scripts": {
    "build": "tsup",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run check && npm run smoke",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck:consumer": "tsc -p tsconfig.consumer.json",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run typecheck:consumer"
  },
  "devDependencies": {
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "1.7.1",
    "@langchain/openai": "1.8.0",
    "ai": "^7.0.163",
    "ai6": "npm:ai@^6.0.323",
    "@types/node": "^22",
    "eslint": "^9",
    "langchain": "1.6.2",
    "tsup": "^8",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3",
    "zod": "4.6.7"
  }
}
